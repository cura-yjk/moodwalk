<% content_for :head do %>
  <%= stylesheet_link_tag "vendor/mapbox-gl", "data-turbo-track": "reload" %>
<% end %>
<div class="preview-screen">
  <div class="preview-header">
    <!-- Placeholder — no favorites/likes column on Journey yet -->
    <button type="button" class="like-btn" disabled>♡</button>
  </div>
  <h1>Your walk is ready 🌿</h1>
  <h2><%= @journey.name %></h2>
  <p class="walk-stats">
    <% if @journey.estimated_duration_seconds %>
      <%= @journey.estimated_duration_seconds / 60 %> min
    <% else %>
      -- min
    <% end %>
    · Loop ·
    <% if @journey.estimated_steps %>
      ~<%= @journey.estimated_steps %> steps
    <% else %>
      -- steps
    <% end %>
  </p>
  <div class="route-map"
       data-controller="map"
       data-map-access-token-value="<%= ENV.fetch("MAPBOX_ACCESS_TOKEN", nil) %>"
       data-map-center-value="<%= @journey.start_coordinates.to_json %>"
       data-map-route-value="<%= @journey.route_coordinates.to_json %>">
  </div>
  <ul class="route-highlights">
    <li>🌿 Greenery along the way</li>
    <li>☀️ Mostly open streets</li>
    <li>🚶 Passes active areas</li>
  </ul>
  <%= button_to "Start walking", journey_walks_path(@journey), method: :post, class: "start-walking-btn" %>
</div>
