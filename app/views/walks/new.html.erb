<% content_for :hide_navbar, true %>
<div class="preview-screen d-flex flex-column align-items-center my-5">
  <div class="title-card">
    <h1 class="mb-3 walk-ready-title">Your walk is ready 🌿</h1>
    <h2 class="journey-title editorial-title"><%= @journey.name %></h2>
    <p class="walk-stats fw-semibold fs-5">
      <% if @journey.estimated_duration_seconds %>
        <%= @journey.estimated_duration_seconds / 60 %> min
      <% else %>
        -- min
      <% end %>
      · <%= @journey.loop? ? "Loop" : "One-way" %> ·
      <% if @journey.estimated_steps %>
        ~<%= @journey.estimated_steps %> steps
      <% else %>
        -- steps
      <% end %>
    </p>
  </div>
  <div class="map-preview route-map"
       data-controller="map"
       data-map-access-token-value="<%= ENV.fetch("MAPBOX_ACCESS_TOKEN", nil) %>"
       data-map-center-value="<%= @journey.start_coordinates.to_json %>"
       data-map-route-value="<%= @journey.route_coordinates.to_json %>">
  </div>
  <ul class="route-highlights list-unstyled">
    <li class="mb-1 fs-5">🌿 Greenery along the way</li>
    <li class="mb-1 fs-5">☀️ Mostly open streets</li>
    <li class="fs-5">🚶 Passes active areas</li>
  </ul>

  <div class="d-flex flex-column w-100 gap-3 my-2">
    <div class="d-flex gap-2 mb-1">
      <%= link_to root_path,
      class: "choice-btn w-50 d-flex align-items-center gap-3 justify-content-center text-decoration-none" do %>
        <i class="fa-solid fa-backward"></i> Back
      <% end %>
      <button type="button" class="choice-btn d-flex align-items-center gap-3 justify-content-center w-50"
        data-controller="journey-save"
        data-journey-save-save-url-value="<%= save_journey_path(@journey) %>"
        data-journey-save-target="button"
        data-action="click->journey-save#save">
        <i class="fa-regular fa-bookmark" data-journey-save-target="icon"></i>
        <span data-journey-save-target="label">Save</span>
      </button>
    </div>

    <%= form_with url: journey_walks_path(@journey), scope: :walk, data: { controller: "carry-checkin-mood" } do |f| %>
      <%= f.hidden_field :mood_before, data: { "carry-checkin-mood-target": "field" } %>
      <%= f.submit "Start walking", class: "done-btn w-100" %>
    <% end %>
    <% if @alternate_journey %>
    <%= link_to "Choose alternate journey",
          new_journey_walk_path(@alternate_journey),
          class: "subtle-btn align-self-center" %>
  <% end %>
  </div>
</div>
