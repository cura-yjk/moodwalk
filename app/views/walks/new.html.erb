<div class="preview-screen d-flex flex-column align-items-center my-5">
  <h1>Your walk is ready 🌿</h1>
  <h2><%= @journey.name %></h2>
  <p class="walk-stats">
    <% if @journey.estimated_duration_seconds %>
      <%= @journey.estimated_duration_seconds / 60 %> min
    <% else %>
      -- min
    <% end %>
    · Loop ·
    <% if @journey.estimated_steps %>
      ~<%= @journey.estimated_steps %> steps
    <% else %>
      -- steps
    <% end %>
  </p>
  <div  class="map-preview" class="route-map my-3"
       data-controller="map"
       data-map-access-token-value="<%= ENV.fetch("MAPBOX_ACCESS_TOKEN", nil) %>"
       data-map-center-value="<%= @journey.start_coordinates.to_json %>"
       data-map-route-value="<%= @journey.route_coordinates.to_json %>">
  </div>
  <ul class="route-highlights list-unstyled">
    <li class="mb-2">🌿 Greenery along the way</li>
    <li class="mb-2">☀️ Mostly open streets</li>
    <li class="mb-2">🚶 Passes active areas</li>
  </ul>
  <div class="submit-container d-flex align-items-center text-align-center gap-2">
    <%= button_to "Start walking", journey_walks_path(@journey), method: :post, class: "confirm-btn" %>
    <button type="button" class="like-btn me-2 btn btn-link" disabled>
      <i class="fa-regular fa-bookmark"></i>
    </button>
  </div>

</div>
