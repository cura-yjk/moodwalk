<% content_for :hide_navbar, true %>
<!-- Outer wrapper carries the Stimulus controllers so the share modal below
     (a sibling of .walk-complete-page, not a descendant) stays in scope for
     Stimulus targets. It deliberately has no position/z-index of its own --
     .walk-complete-page opens its own stacking context (for .leaf-layer, see
     below), and nesting the modal inside that context used to trap it under
     Bootstrap's backdrop (which attaches to <body>, outside that context),
     making the modal render but be unclickable/greyed-out. -->
<div data-controller="community-share journey-save"
     data-community-share-share-url-value="<%= share_walk_path(@walk) %>"
     data-community-share-shared-value="<%= @walk.shared? %>"
     data-community-share-rating-value="<%= @walk.rating %>"
     data-journey-save-save-url-value="<%= save_journey_path(@walk.journey) %>"
     data-journey-save-saved-value="<%= @journey_saved %>">
  <div class="container walk-complete-page d-flex flex-column align-items-center mt-5">
    <!-- Decorative entrance celebration (app/javascript/controllers/leaves_controller.js):
       a brief, calm scatter of leaves/ribbons/particles plus a soft glow near
       the top, playing once on load. Sits behind all the real content below
       but above the body's background gradient -- see .walk-complete-page /
       .leaf-layer stacking in walks/_edit.scss. Purely decorative: it doesn't
       change this page's layout or content. -->
    <div class="leaf-layer" data-controller="leaves">
      <div class="entrance-glow"></div>
    </div>
    <!-- Header copy matching the "walk complete" mockup -->
    <h1 class="mt-5 editorial-title">Walk complete! 🌿</h1>
    <p class="mb-3 text-center">A little more of the world,<br>
      discovered.</p>
    <!-- Hero image: shows the photo captured during the walk, if one exists.
     No photo means the walker skipped the camera step, so nothing renders here. -->
    <% if @walk.photo.attached? %>
      <div class="walk-image">
        <%= image_tag @walk.photo,
        class: "walk-image"
      %>
      </div>
    <% end %>
    <!-- Stat boxes: steps, duration, distance — all pulled from existing data -->
    <div class="stats-row my-4">
      <div class="stats-card">
        <span class="stat-value fw-bold fs-5">
          <i class="fa-solid fa-shoe-prints stats-icon"></i>
          <%= number_with_delimiter(@walk.actual_steps) %></span>
        <span class="stat-label">steps</span>
      </div>
      <div class="stats-card">
        <span class="stat-value fw-bold fs-5">
          <i class="fa-regular fa-clock stats-icon"></i>
          <%= @walk.duration_in_minutes %> min</span>
        <span class="stat-label">walking</span>
      </div>
      <div class="stats-card">
        <span class="stat-value fw-bold fs-5">
          <i class="fa-solid fa-map-pin stats-icon"></i>
          <%= @walk.actual_distance %> km</span>
        <span class="stat-label">distance</span>
      </div>
    </div>
    <!-- Form for the two editable, optional fields: mood_after and reflection -->
    <div class="emoji-form d-flex flex-column align-items-center">
      <%= form_with model: @walk, url: walk_path(@walk), method: :patch do |f| %>
        <h4 class="my-3 text-start mood-question">How do you feel now?</h4>
        <!-- Mood options come from the shared ApplicationHelper::MOOD_ICONS
          mapping, not stored in the DB as a table — mood_after is a plain
          string, and this keeps the picker in sync with the icons shown
          elsewhere (e.g. the walks index) -->
        <div class="mood-selector d-flex justify-content-center gap-2">
          <% ApplicationHelper::MOOD_ICONS.each do |value, image| %>
            <label class="mood-btn <%= 'selected' if @walk.mood_after == value %>">
              <%= f.radio_button :mood_after, value, checked: (@walk.mood_after == value), class: "mood-radio-hidden" %>
              <%= image_tag image, alt: value, class: "mood-icon" %>
            </label>
          <% end %>
        </div>
        <h6 class="my-4 text-start">Anything you want to remember?</h6>
        <%= f.text_area :reflection, placeholder: "A thought, a feeling, something you noticed...", class: "mb-4", id: "journal-input", rows: 2 %>
        <!-- Suggested route vs. where the walker actually went. Only shown when the
       walk was GPS-tracked (see walking_controller.js / Walk#finalize_actual_path!). -->
        <% if @walk.actual_route_coordinates.any? %>
          <div class="route-compare">
            <div class="route-compare-map"
              data-controller="route-comparison-map"
              data-route-comparison-map-access-token-value="<%= ENV.fetch("MAPBOX_ACCESS_TOKEN", nil) %>"
              data-route-comparison-map-center-value="<%= @walk.journey.start_coordinates.to_json %>"
              data-route-comparison-map-suggested-value="<%= @walk.journey.route_coordinates.to_json %>"
              data-route-comparison-map-actual-value="<%= @walk.actual_route_coordinates.to_json %>">
            </div>
            <div class="route-compare-legend d-flex justify-content-center gap-4">
              <span class="route-compare-key"><span class="route-compare-swatch route-compare-swatch--suggested"></span> Suggested</span>
              <span class="route-compare-key"><span class="route-compare-swatch route-compare-swatch--actual"></span> Your route</span>
            </div>
          </div>
        <% end %>
        <!-- Placeholder actions — not wired up yet, per your request -->
        <%= f.submit "Done", class: "done-btn my-3 w-100" %>
        <div class="placeholder-actions d-flex w-100 gap-3 my-2 mb-5">
          <button type="button" class="choice-btn w-50 d-flex align-items-center gap-3 justify-content-center"
          data-journey-save-target="button"
          data-action="click->journey-save#save">
            <i class="fa-regular fa-bookmark" data-journey-save-target="icon"></i>
            <span data-journey-save-target="label">Save</span>
          </button>
          <button type="button" class="choice-btn w-50 d-flex align-items-center gap-3 justify-content-center"
          data-community-share-target="button"
          data-bs-toggle="modal" data-bs-target="#shareModal">
            <i class="fa-solid fa-share" data-community-share-target="buttonIcon"></i>
            <span data-community-share-target="buttonLabel">Post</span>
          </button>
        </div>
        <!-- The one real action on this page: submits mood_after + reflection,
           then WalksController#update redirects to the memory-card page -->
      <% end %>
    </div>
  </div>
  <!-- Share to Community modal (see screenshot mockup): rating + optional
       review, submitted via community-share#share as a PATCH to
       WalksController#share. Lives outside the mood/reflection form above
       so it isn't nested inside another <form>. Bootstrap's JS (loaded
       globally, see application.js) handles opening/closing via the
       data-bs-toggle/data-bs-target attributes and Modal instance below. -->
  <div class="modal fade share-modal" id="shareModal" tabindex="-1" aria-hidden="true"
       data-community-share-target="modal"
       data-action="shown.bs.modal->community-share#prefillReview">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content share-modal-content">
        <div class="modal-header border-0 pb-0">
          <div>
            <h2 class="modal-title editorial-title share-modal-title">Share to Community</h2>
            <p class="text-muted mb-0">Share your walk to inspire other walkers 🌿</p>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="share-preview-card">
            <% if @walk.photo.attached? %>
              <div class="share-preview-photo">
                <%= image_tag @walk.photo, class: "share-preview-image" %>
              </div>
            <% end %>
            <div class="share-preview-body">
              <div class="d-flex align-items-start gap-2">
                <span class="share-preview-icon"><i class="fa-solid fa-location-dot"></i></span>
                <div>
                  <h3 class="share-preview-name"><%= @walk.journey.name %></h3>
                  <% if @walk.journey.description.present? %>
                    <p class="share-preview-description text-muted mb-0"><%= @walk.journey.description %></p>
                  <% end %>
                </div>
              </div>
              <div class="share-preview-stats d-flex">
                <div class="share-preview-stat text-center">
                  <div class="share-preview-stat-icon">👣</div>
                  <div class="share-preview-stat-value fw-bold"><%= number_with_delimiter(@walk.actual_steps) %></div>
                  <div class="share-preview-stat-label text-muted">steps</div>
                </div>
                <div class="share-preview-stat text-center">
                  <div class="share-preview-stat-icon"><i class="fa-regular fa-clock"></i></div>
                  <div class="share-preview-stat-value fw-bold"><%= @walk.duration_in_minutes %> min</div>
                  <div class="share-preview-stat-label text-muted">walking</div>
                </div>
                <div class="share-preview-stat text-center">
                  <div class="share-preview-stat-icon"><i class="fa-solid fa-location-dot"></i></div>
                  <div class="share-preview-stat-value fw-bold"><%= @walk.actual_distance %> km</div>
                  <div class="share-preview-stat-label text-muted">distance</div>
                </div>
              </div>
            </div>
          </div>
          <h4 class="share-question mt-4 mb-1">How was your walk?</h4>
          <p class="text-muted mb-2">Rate your overall experience</p>
          <div class="share-star-rating" data-community-share-target="stars">
            <% (1..5).each do |value| %>
              <i class="fa-solid fa-star share-star" data-rating="<%= value %>" data-action="click->community-share#setRating"></i>
            <% end %>
          </div>
          <p class="share-rating-label text-center mb-0" data-community-share-target="ratingLabel">&nbsp;</p>
          <h4 class="share-question mt-4 mb-2">Write a review <span class="text-muted fw-normal">(optional)</span></h4>
          <textarea class="share-review-textarea" maxlength="150" rows="3"
            placeholder="What made this walk special?"
            data-community-share-target="review"
            data-action="input->community-share#countChars"></textarea>
          <p class="share-char-count text-end text-muted mb-0">
            <span data-community-share-target="charCount">0</span>/150
          </p>
          <button type="button" class="done-btn w-100 mt-3 d-flex align-items-center justify-content-center gap-2"
            data-community-share-target="submitButton"
            data-action="click->community-share#share">
            <i class="fa-solid fa-users"></i>
            <span data-community-share-target="submitLabel">Share to Community</span>
          </button>
          <p class="share-modal-footnote text-center text-muted mb-1 mt-2">
            <i class="fa-solid fa-lock"></i> Your name will be shown as MoodWalker
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
