<div class="container d-flex flex-column align-items-center mt-5">

  <!-- Header copy matching the "walk complete" mockup -->
  <h1 class="mt-5">Walk complete! 🌿</h1>
  <p class="mb-3">A little more of the world, discovered.</p>

  <!-- Hero image: shows the photo captured during the walk, if one exists.
     Falls back to a generic placeholder if the user skipped the camera step. -->
  <div class="walk-image">
    <% if @walk.photo.attached? %>
      <%= image_tag @walk.photo,
        class: "walk-image"
      %>
    <% else %>
      <%= image_tag "https://thumbs.dreamstime.com/b/quiet-street-small-american-town-42895985.jpg",
        class: "walk-image"
      %>
    <% end %>
  </div>

  <!-- Stat boxes: steps, duration, distance — all pulled from existing data -->
  <div class="stats-row my-4">
    <div class="stats-card">
      <span class="stat-value fw-bold fs-5">👣 <%= @walk.actual_steps %></span>
      <span class="stat-label">steps</span>
    </div>
    <div class="stats-card">
      <span class="stat-value fw-bold fs-5">⏲ <%= @walk.duration_in_minutes %> min</span>
      <span class="stat-label">walking</span>
    </div>
    <div class="stats-card">
      <span class="stat-value fw-bold fs-5">📍 <%= @walk.actual_distance %> km</span>
      <span class="stat-label">distance</span>
    </div>
  </div>

  <!-- Form for the two editable, optional fields: mood_after and reflection -->
  <div class="emoji-form d-flex flex-column align-items-center">
    <%= form_with model: @walk, url: walk_path(@walk), method: :patch do |f| %>

      <h4 class="my-4 text-center">How do you feel now?</h4>

      <!-- Fixed set of 5 mood options — not stored in the DB as a table,
          just a small array we define here since mood_after is a plain string -->
      <% mood_options = [
        { value: "Sad",   emoji: "😢" },
        { value: "Down",  emoji: "🙁" },
        { value: "Okay",  emoji: "😐" },
        { value: "Good",  emoji: "🙂" },
        { value: "Great", emoji: "😃" }
      ] %>

      <div class="mood-selector d-flex gap-4">
        <% mood_options.each do |mood| %>
          <label class="mood-btn <%= 'selected' if @walk.mood_after == mood[:value] %>">
            <%= f.radio_button :mood_after, mood[:value],
                  checked: (@walk.mood_after == mood[:value]),
                  class: "mood-radio-hidden" %>
            <span class="emoji"><%= mood[:emoji] %></span>
          </label>
        <% end %>
      </div>
  </div>

    <h6 class="mt-5 text-center">Anything you want to remember? (optional)</h6>
    <%= f.text_area :reflection,
          placeholder: "A thought, a feeling, something you noticed...",
          class: "mb-3", id: "journal-input",
          rows: 3 %>

    <!-- Placeholder actions — not wired up yet, per your request -->
    <div class="placeholder-actions d-flex w-100 gap-2 my-2">
      <button type="button" class="choice-btn w-50 d-flex align-items-center gap-3 justify-content-center" disabled>
        Save
        <i class="fa-regular fa-bookmark"></i>
      </button>
      <button type="button" class="choice-btn w-50" disabled>
        Share
        <i class="fa-solid fa-share"></i>
      </button>
    </div>

    <!-- The one real action on this page: submits mood_after + reflection,
         then WalksController#update redirects to walks#index -->
    <%= f.submit "Done", class: "done-btn my-3 w-100" %>
  <% end %>

</div>
