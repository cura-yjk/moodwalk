<%= link_to new_journey_walk_path(journey), class: "route-card h-100 w-100 text-decoration-none text-reset mb-3" do %>
  <div class="route-card-photo position-relative">
    <%= image_tag Journey::PLACEHOLDER_IMAGES.sample,
          class: "community-image" %>
          <span class="route-card-title position-absolute bottom-0 start-0 p-2 text-white"><%= journey.name %></span>
          <% if journey.estimated_duration_seconds %>
            <span class="route-card-duration"><i class="fa-regular fa-clock"></i> <%= journey.estimated_duration_seconds / 60 %> min</span>
          <% end %>
  </div>

  <div class="route-card-body d-flex flex-column align-items-start w-100">
    <div class="mb-1 d-flex align-items-center mb-2">
      <i class="fa-solid fa-location-dot me-1"></i><span>Location name</span>
    </div>
    <div class="route-card-meta d-flex justify-content-evenly gap-3 mb-2">
      <span><%= journey.length_label %></span>
      <span><i class="fa-solid fa-person-walking"></i> <%= journey.placeholder_walker_count %></span>
    </div>
    <div class="route-card-tags d-flex flex-wrap gap-1">
      <% journey.tags.each do |tag| %>
        <span class="badge route-tag"><%= tag %></span>
      <% end %>
    </div>
  </div>
<% end %>
