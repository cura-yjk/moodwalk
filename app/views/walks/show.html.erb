<!-- app/views/walks/show.html.erb -->
<% content_for :hide_navbar, true %>
<div class="walking-screen"
     data-controller="walking"
     data-walking-waypoints-value="<%= @journey.turn_waypoints.to_json %>"
     data-walking-dev-mode-value="<%= Rails.env.development? %>">
  <div class="walking-background"><!-- placeholder for atmospheric bg --></div>
  <!-- <label class="camera-btn" data-walking-target="cameraButton">
    <input type="file" accept="image/*" capture="environment" class="d-none" data-action="change->walking#photoTaken">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 8h3l2-2h6l2 2h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z"/>
      <circle cx="12" cy="14" r="3.5"/>
    </svg>
  </label> -->
  <!-- Camera button now triggers openCamera instead of a file input -->
  <button type="button"
          class="camera-btn"
          data-walking-target="cameraButton"
          data-action="click->walking#openCamera">
    <svg data-walking-target="cameraIcon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 8h3l2-2h6l2 2h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z"/>
      <circle cx="12" cy="14" r="3.5"/>
    </svg>
    <!-- Checkmark swaps in once a photo's been captured — hidden until then -->
    <svg data-walking-target="checkIcon" class="d-none" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 6L9 17l-5-5"/>
    </svg>
  </button>

  <!-- Full-screen camera overlay, hidden until openCamera shows it -->
  <div class="camera-overlay d-none" data-walking-target="cameraOverlay">
    <video data-walking-target="video" autoplay playsinline muted class="camera-video"></video>
    <canvas data-walking-target="canvas" class="d-none"></canvas>

    <div class="camera-controls">
      <button type="button" class="camera-cancel" data-action="click->walking#cancelCamera">Cancel</button>
      <button type="button" class="camera-shutter" data-action="click->walking#capturePhoto">
        <span class="shutter-circle"></span>
      </button>
    </div>
  </div>
  <div class="walking-guidance">
    <div class="direction-arrow-wrap">
      <div class="direction-arrow" data-walking-target="arrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 19V5"/>
          <path d="M5 12l7-7 7 7"/>
        </svg>
      </div>
    </div>
    <p class="steps-remaining"><span data-walking-target="stepsCount">--</span> steps</p>
    <p class="instruction-text" data-walking-target="instructionText">Getting your location…</p>
  </div>
  <div class="walking-bottom">

    <div class="user-view">
        <p class="next-instruction next-instruction-hidden" data-walking-target="nextRow">
          <span class="next-instruction-label d-flex flex-start">THEN</span>
          <span data-walking-target="nextInstructionText"></span>
        </p>

        <label class="camera-btn" data-walking-target="cameraButton">
          <input type="file" accept="image/*" capture="environment" class="d-none" data-action="change->walking#photoTaken">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 8h3l2-2h6l2 2h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z"/>
              <circle cx="12" cy="14" r="3.5"/>
            </svg>
        </label>

    </div>
      <%= button_to "End Walk", complete_walk_path(@walk), method: :patch, class: "end-walk-btn" %>
  </div>
</div>
