<!-- app/views/walks/show.html.erb -->
<% content_for :hide_navbar, true %>
<div class="walking-screen"
     data-controller="walking"
     data-walking-waypoints-value="<%= @journey.turn_waypoints.to_json %>"
     data-walking-dev-mode-value="<%= Rails.env.development? %>"
     data-walking-attach-photo-url-value="<%= attach_photo_walk_path(@walk) %>"
     data-walking-track-url-value="<%= track_walk_path(@walk) %>">
  <div class="walking-background"><!-- placeholder for atmospheric bg --></div>

  <button type="button" class="walking-map-toggle" aria-label="Show route map">
    <i class="fa-solid fa-map"></i>
  </button>

  <div class="walking-guidance">
    <div class="direction-arrow-wrap">
      <div class="direction-arrow" data-walking-target="arrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 19V5"/>
          <path d="M5 12l7-7 7 7"/>
        </svg>
      </div>
    </div>
    <p class="instruction-text" data-walking-target="instructionText">Getting your location…</p>
  </div>
  <div class="walking-bottom">

    <div class="user-view">
        <p class="next-instruction next-instruction-hidden" data-walking-target="nextRow">
          <span class="next-instruction-label d-flex flex-start">THEN</span>
          <span data-walking-target="nextInstructionText"></span>
        </p>

        <label class="camera-btn" data-walking-target="cameraButton">
          <input type="file" accept="image/*" capture="environment" class="d-none" data-action="change->walking#photoTaken">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 8h3l2-2h6l2 2h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z"/>
            <circle cx="12" cy="14" r="3.5"/>
          </svg>
        </label>

    </div>
      <%= form_with model: @walk, url: complete_walk_path(@walk), method: :patch,
      html: { data: { walking_target: "endWalkForm" } } do |f| %>
        <%= f.hidden_field :actual_distance, data: { walking_target: "distanceField" } %>
        <%= f.hidden_field :actual_steps, data: { walking_target: "stepsField" } %>
        <%= f.submit "End Walk", class: "end-walk-btn mb-3", data: { action: "click->walking#endWalk" } %>
      <% end %>
  </div>
</div>
