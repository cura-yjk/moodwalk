<div class="community-routes-page container my-5">
  <div class="community-routes-header">
    <div>
      <h1 class="editorial-title community-routes-title mb-0">Community Routes</h1>
      <p class="community-routes-subtitle mb-0">Walks loved by your neighbours</p>
    </div>
  </div>

  <div class="route-card-list">
    <% @journeys.each do |journey| %>
      <%= link_to community_route_path(journey), class: "route-card text-decoration-none text-reset" do %>
        <div class="route-card-photo">
          <%= image_tag journey.community_photos(limit: 1).first&.photo || Journey::PLACEHOLDER_IMAGES.sample,
                class: "route-card-image" %>
          <span class="route-card-duration"><i class="fa-regular fa-clock"></i> <%= journey.estimated_duration_seconds / 60 %> min</span>
          <span class="route-card-title"><%= journey.name %></span>
        </div>

        <div class="route-card-body">
          <div class="mb-1 d-flex align-items-center mb-2">
            <i class="fa-solid fa-location-dot me-1"></i><span>Location name</span>
            <span class="route-card-rating"><i class="fa-solid fa-star"></i> <%= journey.placeholder_rating %></span>
          </div>
          <div class="route-card-meta">
            <span><i class="fa-solid fa-person-hiking"></i> <%= journey.length_label %></span>
            <span><i class="fa-solid fa-users"></i> <%= journey.placeholder_walker_count %></span>
          </div>
          <div class="route-card-tags">
            <% journey.tags.each do |tag| %>
              <span class="route-tag"><%= tag %></span>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
