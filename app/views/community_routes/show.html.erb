<div class="route-hero">
  <%= image_tag @recent_photos.first&.photo || @journey.placeholder_image,
        class: "route-hero-image" %>
</div>

<div class="community-route-detail container">
  <div class="route-detail-body">
    <span class="label text-muted text-uppercase small">Community Route</span>
    <h1 class="route-detail-title editorial-title"><%= @journey.name %></h1>
    <% if @journey.description.present? %>
      <p class="route-detail-description"><%= @journey.description %></p>
    <% end %>

    <div class="route-detail-stats">
      <div class="route-detail-stat">
        <i class="fa-regular fa-clock"></i>
        <span class="route-detail-stat-value"><%= @journey.estimated_duration_seconds / 60 %> min</span>
        <span class="route-detail-stat-label">Duration</span>
      </div>
      <div class="route-detail-stat">
        <i class="fa-solid fa-route"></i>
        <span class="route-detail-stat-value"><%= (@journey.distance_meters / 1000.0).round(1) %> km</span>
        <span class="route-detail-stat-label">Distance</span>
      </div>
      <div class="route-detail-stat">
        <i class="fa-solid fa-shoe-prints"></i>
        <span class="route-detail-stat-value"><%= @journey.estimated_steps_display %></span>
        <span class="route-detail-stat-label">Steps</span>
      </div>
      <div class="route-detail-stat">
        <i class="fa-solid fa-star"></i>
        <span class="route-detail-stat-value"><%= @journey.placeholder_rating %></span>
        <span class="route-detail-stat-label">Rating</span>
      </div>
    </div>

    <% if @journey.tags.any? %>
      <h2 class="route-detail-heading">What this walk feels like</h2>
      <div class="route-detail-tags">
        <% @journey.tags.each do |tag| %>
          <span class="route-tag"><%= tag %></span>
        <% end %>
      </div>
    <% end %>

    <div class="map-preview route-map mx-auto mt-4"
         data-controller="map"
         data-map-access-token-value="<%= ENV.fetch("MAPBOX_ACCESS_TOKEN", nil) %>"
         data-map-center-value="<%= @journey.start_coordinates.to_json %>"
         data-map-route-value="<%= @journey.route_coordinates.to_json %>">
    </div>

    <% moment_photos = @recent_photos.any? ? @recent_photos.map(&:photo) : Array.new(4) { Journey::PLACEHOLDER_IMAGES.sample } %>
    <div class="photo-carousel my-4">
      <h2 class="route-detail-heading">Other moments from walkers</h2>

      <div id="momentsCarousel" class="carousel slide route-moments-carousel">
        <div class="carousel-inner">
          <% moment_photos.each_with_index do |photo, index| %>
            <div class="carousel-item <%= "active" if index.zero? %>">
              <%= image_tag photo, class: "d-block w-100 route-moments-photo" %>
            </div>
          <% end %>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#momentsCarousel" data-bs-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#momentsCarousel" data-bs-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Next</span>
        </button>
      </div>
    </div>
  </div>

  <div class="d-flex flex-column w-100 gap-3 route-detail-actions">
    <div class="d-flex gap-2 mb-1">
      <%= link_to community_routes_path,
      class: "choice-btn w-50 d-flex align-items-center gap-3 justify-content-center text-decoration-none" do %>
        <i class="fa-solid fa-backward"></i> Back
      <% end %>
      <button type="button" class="choice-btn d-flex align-items-center gap-3 justify-content-center w-50"
        data-controller="journey-save"
        data-journey-save-save-url-value="<%= save_journey_path(@journey) %>"
        data-journey-save-target="button"
        data-action="click->journey-save#save">
        <i class="fa-regular fa-bookmark" data-journey-save-target="icon"></i>
        <span data-journey-save-target="label">Save</span>
      </button>
    </div>

    <%= button_to "Start Walking", journey_walks_path(@journey), method: :post, class: "done-btn w-100" %>
  </div>
</div>
