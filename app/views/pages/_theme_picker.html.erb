<%# Tapping a mood card no longer submits straight away -- it opens a bottom
    sheet (duration_picker_controller.js, same pattern as shared/_mood_checkin)
    asking how long the user has, then submits the one shared form below with
    both the chosen theme and duration. %>
<div class="theme-picker" data-controller="duration-picker" data-action="keydown.esc@window->duration-picker#close">
  <% THEMES.each do |key, theme| %>
    <button type="button" class="theme-card" data-theme="<%= key %>"
      data-action="duration-picker#open"
      data-duration-picker-theme-key-param="<%= key %>"
      data-duration-picker-theme-label-param="<%= theme[:label] %>"
      data-duration-picker-theme-subtitle-param="<%= theme[:subtitle] %>"
      data-duration-picker-theme-icon-param="<%= theme[:icon] %>">
      <i class="<%= theme[:icon] %>"></i>
      <span><%= theme[:label] %></span>
    </button>
  <% end %>
  <button type="button" class="theme-card" data-theme="surprise_me"
    data-action="duration-picker#open"
    data-duration-picker-theme-key-param="surprise_me"
    data-duration-picker-theme-label-param="Surprise me"
    data-duration-picker-theme-subtitle-param="We'll pick the mood for you"
    data-duration-picker-theme-icon-param="fa-solid fa-shuffle">
    <i class="fa-solid fa-shuffle"></i>
    <span>Surprise me</span>
  </button>

  <div class="bottom-sheet-backdrop" data-duration-picker-target="backdrop" data-action="click->duration-picker#close"></div>

  <div class="bottom-sheet duration-sheet" role="dialog" aria-modal="true" aria-labelledby="duration-sheet-title" data-duration-picker-target="sheet">
    <div class="bottom-sheet-handle"></div>

    <div class="duration-sheet-icon" data-duration-picker-target="icon"></div>
    <h3 id="duration-sheet-title" class="duration-sheet-title" data-duration-picker-target="title"></h3>
    <p class="duration-sheet-subtitle" data-duration-picker-target="subtitle"></p>

    <h5 class="duration-sheet-question">How long do you have?</h5>
    <p class="duration-sheet-hint">We'll curate the best walk for the time you have.</p>

    <%= form_with url: journeys_path, method: :post, class: "duration-sheet-form", data: { duration_picker_target: "form" } do |f| %>
      <%= f.hidden_field :theme_key, data: { duration_picker_target: "themeKeyInput" } %>
      <%= f.hidden_field :duration_minutes, data: { duration_picker_target: "durationInput" } %>

      <div class="duration-options">
        <% [10, 20, 30].each do |minutes| %>
          <button type="button" class="duration-option" data-duration-picker-target="option"
            data-action="duration-picker#selectDuration" data-duration-picker-minutes-param="<%= minutes %>">
            <span class="duration-option-value"><%= minutes %></span>
            <span class="duration-option-unit">min</span>
          </button>
        <% end %>
      </div>

      <button type="button" class="no-rush-option" data-duration-picker-target="option"
        data-action="duration-picker#selectDuration" data-duration-picker-minutes-param="">
        <span class="no-rush-title">No rush</span>
        <span class="no-rush-subtitle">I have plenty of time</span>
      </button>

      <%= f.submit "Find me a walk", class: "find-walk-btn" %>
    <% end %>
  </div>
</div>
