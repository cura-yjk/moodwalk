<div class="container d-flex flex-column justify-content-center align-items-center mt-5"
 id="suggestion-container" data-controller="geolocation">
  <div class="d-flex flex-column">
    <% if user_signed_in? %>
          <div class="home-header d-flex justify-content-between align-items-center gap-3 my-4">
            <h5 class="greeting mb-0">
              <%= "How's today, #{current_user.name.capitalize}?" %>
            </h5>
            <%= render "shared/mood_checkin" %>
          </div>
          <div class="subtitle">
            <h1 class="mb-3 editorial-title">How would you like to feel after your walk?</h1>
            <h6 class="mb-4">Choose a feeling. MoodWalk will do the rest.</h6>
          </div>
      <%= render "theme_picker" %>
      <div class="d-flex justify-content-between align-items-center mt-2">
        <h5 class="mb-0">Ideas for you, right here</h5>
        <%= link_to "See all >", community_routes_path, class: "link-btn" %>
      </div>
      <div id="suggest-container" class="mt-3 mb-3 journey-cards">
        <%# Carousel start %>
        <div id="carouselExampleIndicators" class="carousel slide">
          <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
          </div>
          <div class="carousel-inner">
            <% if @journeys.present? %>
              <% @journeys.each_with_index do |journey, index| %>
                <div class="carousel-item <%= "active" if index == 0 %> ">
                  <%= link_to community_route_path(journey), class: "journey-card text-decoration-none" do %>
                    <div class="card-image">
                      <%= image_tag journey.placeholder_image, alt: journey.name, class: "card-photo" %>
                      <div class="card-info">
                        <div class="card-title-row">
                          <h4><%= journey.name %></h4>
                          <% if journey.estimated_duration_seconds.present? %>
                            <span class="card-duration"><%= (journey.estimated_duration_seconds / 60.0).round %> min</span>
                          <% end %>
                        </div>
                        <p>
                          <%= journey.description %>
                        </p>
                      </div>
                    </div>
                  </div>
                <% end %> <%# Closes link_to %>
               </div>
              <% end %> <%# Closes @journeys.each %>
            <% end %>
          </div>
          <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
          </button>
        </div>
        <%# Carousel end %>
        <%# Closes if @journeys.present? %>
      </div>
      <%# Closes #suggest-container %>
    <% end %> <%# Closes if user_signed_in? %>
  </div>
  <%# Closes .d-flex.flex-column %>
</div>
<%# Closes #suggestion-container %>
