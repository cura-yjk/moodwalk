<div class="container d-flex flex-column justify-content-center align-items-center mt-5"
 id="suggestion-container" data-controller="geolocation">
  <div class="d-flex flex-column">
    <% if user_signed_in? %>
      <div class="home-header d-flex justify-content-between align-items-center gap-3 my-4">
        <h2 class="greeting mb-0">
          <%= "#{time_based_greeting}, #{current_user.name.capitalize}" %>
        </h2>
        <%= render "shared/mood_checkin" %>
      </div>
      <div class="subtitle">
        <h1 class="mb-3 editorial-title">Pick a feeling. MoodWalk will do the rest.</h1>
        <h6>We’ll build the perfect route. You just walk, clear your mind, and journal it.</h6>
        <div class="d-flex justify-content-between" data-controller="location-search">
          <div class="position-relative">
            <p class="mb-4">📍 Starting from <%= current_user.current_location_name || "your area" %></p>
            <%= form_tag("#", method: :patch, class: "d-none mb-2", data: { location_search_target: "form", action: "submit->location-search#submit" }) do %>
              <%= text_field_tag :query, nil,
                    placeholder: "Search for a starting point",
                    class: "form-control form-control-sm",
                    autocomplete: "off",
                    data: {
                      location_search_target: "input",
                      action: "input->location-search#type keydown.esc->location-search#close"
                    } %>
            <% end %>
            <ul class="location-suggestions list-unstyled d-none" data-location-search-target="suggestions"></ul>
          </div>
          <div>
            <%= link_to "Change", "#", class: "link-btn", data: { action: "location-search#toggle" } %>
          </div>
        </div>
      </div>
      <%= render "theme_picker" %>
      <div class="d-flex justify-content-between align-items-center mt-4">
        <h5 class="mb-0">Ideas for you, right here</h5>
        <%= link_to "See all >", community_routes_path, class: "link-btn" %>
      </div>
      <div id="suggest-container" class="mt-3 mb-3 journey-cards">
        <%# Carousel start %>
        <div id="carouselExampleIndicators" class="carousel slide">
          <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
          </div>
          <div class="carousel-inner">
            <% if @journeys.present? %>
              <% @journeys.each_with_index do |journey, index| %>
                <div class="carousel-item <%= "active" if index == 0 %> ">
                  <%= link_to community_route_path(journey), class: "journey-card text-decoration-none" do %>
                    <div class="card-image">
                      <%= image_tag Journey::PLACEHOLDER_IMAGES.sample, alt: journey.name, class: "card-photo" %>
                      <div class="card-info">
                        <div class="card-title-row">
                          <h4><%= journey.name %></h4>
                          <% if journey.estimated_duration_seconds.present? %>
                            <span class="card-duration"><%= (journey.estimated_duration_seconds / 60.0).round %> min</span>
                          <% end %>
                        </div>
                        <p>
                          <%= journey.description %>
                        </p>
                      </div>
                    </div>
                  </div>
                <% end %> <%# Closes link_to %>
              <% end %> <%# Closes @journeys.each %>
            <% end %>
          </div>
          <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
          </button>
        </div>
        <%# Carousel end %>
        <%# Closes if @journeys.present? %>
      </div>
      <%# Closes #suggest-container %>
    <% end %> <%# Closes if user_signed_in? %>
  </div>
  <%# Closes .d-flex.flex-column %>
</div>
<%# Closes #suggestion-container %>
